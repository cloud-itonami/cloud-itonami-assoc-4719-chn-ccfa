(ns association-facts-test
  (:require [kotoba.bytes :as kbytes] [clojure.java.io :as io] [kotoba.process :as shell]
            [kotoba.test :refer [deftest is testing]]
            [kotoba.compiler.core :as compiler] [kotoba.kir :as ir]))
(def source (slurp "src/association_facts.kotoba"))
(defn call [kir function & args] (ir/execute kir function (vec args)))
(defn present [option] (when (second option) (nth option 2)))
(def fields ["id" "title" "association" "isic" "country" "kind" "url"
             "url-provenance" "established-date" "last-revised-date" "retrieved-at"])
(def expected
  [{"id" "ccfa.about-organization"
    "title" "中国连锁经营协会简介 (About CCFA, organization profile)"
    "association" "ccfa" "isic" "4719" "country" "CHN" "kind" "governance-program"
    "url" "http://www.ccfa.org.cn/portal/cn/xiangxic.jsp?type=11"
    "url-provenance" "official-association-site" "established-date" "1997"
    "last-revised-date" "2025-01-01" "retrieved-at" "2026-07-27"}
   {"id" "ccfa.china-franchise-expo"
    "title" "中国特许加盟展 (China Franchise Expo), 经中国商务部批准、由中国连锁经营协会主办"
    "association" "ccfa" "isic" "4719" "country" "CHN" "kind" "sector-program"
    "url" "http://www.ccfa.org.cn/portal/cn/xiangxic.jsp?type=11"
    "url-provenance" "official-association-site" "established-date" "1999"
    "last-revised-date" "2025-01-01" "retrieved-at" "2026-07-27"}])

(deftest reference-preserves-present-fields-absence-and-topics
  (let [kir (:kir (compiler/compile-source source :js-kotoba-v1))
        observed (mapv (fn [i] (into {} (map (fn [f] [f (present (call kir 'entry-field "ccfa" i f))]) fields))) [0 1])]
    (is (= expected observed))
    (testing "the two entries carry DIFFERENT establishment years -- the association 1997, the expo 1999"
      (is (= ["1997" "1999"] (mapv #(present (call kir 'entry-field "ccfa" % "established-date")) [0 1]))))
    (is (= [2 1] (mapv #(call kir 'topic-count "ccfa" %) [0 1])))
    (is (= ["governance" "standards"] (mapv #(present (call kir 'topic "ccfa" 0 %)) [0 1])))
    (is (= "ccfa.china-franchise-expo" (present (call kir 'by-topic-id "ccfa" "franchising" 0))))
    (is (= #{} (set (:effects kir))))
    (testing "unknown values and invalid indexes fail closed"
      (is (zero? (call kir 'entry-count "caam")) "a sibling CHN association is not covered here")
      (is (zero? (call kir 'entry-count "nrf")) "nor is the usa-nrf peer")
      (is (nil? (present (call kir 'entry-field "ccfa" -1 "id"))))
      (is (nil? (present (call kir 'entry-field "ccfa" 2 "id"))))
      (is (nil? (present (call kir 'entry-field "ccfa" 0 "member-count"))))
      (is (nil? (present (call kir 'topic "ccfa" 1 1))))
      (is (zero? (call kir 'by-topic-count "ccfa" "human-rights")))
      (is (nil? (present (call kir 'by-topic-id "ccfa" "franchising" 1)))))
    (testing "the coverage note records that 4719 is narrower than CCFA's own scope"
      (is (re-find #"narrower than CCFA itself" (present (call kir 'coverage-note "ccfa")))))))

(defn compiler-root []
  (nth (iterate #(.getParent ^java.nio.file.Path %)
                (java.nio.file.Path/of (.toURI (io/resource "kotoba/compiler/core.clj")))) 4))
(defn base64 [value] (kbytes/base64-encode value))
(deftest restricted-javascript-and-typed-wasm-conform-semantically
  (let [javascript (compiler/compile-source source :js-kotoba-v1)
        wasm (compiler/compile-source source :wasm32-browser-kotoba-v1)
        js64 (base64 (kbytes/utf8-bytes ^String (:source javascript))) wasm64 (base64 ^bytes (:bytes wasm))
        probe (shell/sh "node" "--input-type=module" "-e"
                (str "import(process.argv[1]).then(async host=>{const j=await import('data:text/javascript;base64," js64 "');"
                     "const w=await host.instantiateKotoba(Buffer.from(process.argv[2],'base64'));const run=x=>{"
                     "if(x['entry-count']('ccfa')!==2n||x['entry-field']('ccfa',0n,'established-date')[2]!=='1997'||x['entry-field']('ccfa',1n,'established-date')[2]!=='1999')throw Error('dates');"
                     "if(x['topic-count']('ccfa',0n)!==2n||x['topic']('ccfa',0n,1n)[2]!=='standards'||x['topic-count']('ccfa',1n)!==1n)throw Error('topics');"
                     "if(x['by-topic-id']('ccfa','franchising',0n)[2]!=='ccfa.china-franchise-expo'||x['topic']('ccfa',1n,1n)[1]!==false)throw Error('query');};"
                     "run(j.instantiateKotoba({}));run(w.instance.exports);}).catch(e=>{console.error(e);process.exit(99)})")
                (.toString (.toUri (.resolve (compiler-root) "runtime/browser-host.mjs"))) wasm64)]
    (is (zero? (:exit probe)) (str (:out probe) (:err probe)))))
(deftest production-source-authority
  (is (= ["src/association_facts.kotoba"]
         (->> (file-seq (io/file "src")) (filter #(.isFile %)) (map str) sort vec))))

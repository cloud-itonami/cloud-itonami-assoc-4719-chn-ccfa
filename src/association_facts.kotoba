(ns association-facts
  (:export [main association-covered? entry-count entry-field topic-count
            topic by-topic-count by-topic-id coverage-note]))

(defn association-covered? [association :string] :bool
  (string=? association "ccfa"))
(defn entry-count [association :string] :i64
  (if (association-covered? association) 2 0))
(defn valid-entry? [association :string index :i64] :bool
  (if (association-covered? association)
    (if (= index 0) true (if (= index 1) true false))
    false))

(defn entry-field [association :string index :i64 field :string]
  [:option :string]
  (if (valid-entry? association index)
    (if (= index 0)
      (cond
        (string=? field "id") (option-some-of [:option :string] "ccfa.about-organization")
        (string=? field "title") (option-some-of [:option :string] "中国连锁经营协会简介 (About CCFA, organization profile)")
        (string=? field "association") (option-some-of [:option :string] "ccfa")
        (string=? field "isic") (option-some-of [:option :string] "4719")
        (string=? field "country") (option-some-of [:option :string] "CHN")
        (string=? field "kind") (option-some-of [:option :string] "governance-program")
        (string=? field "url") (option-some-of [:option :string] "http://www.ccfa.org.cn/portal/cn/xiangxic.jsp?type=11")
        (string=? field "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? field "established-date") (option-some-of [:option :string] "1997")
        (string=? field "last-revised-date") (option-some-of [:option :string] "2025-01-01")
        (string=? field "retrieved-at") (option-some-of [:option :string] "2026-07-27")
        :else (option-none-of [:option :string]))
      (cond
        (string=? field "id") (option-some-of [:option :string] "ccfa.china-franchise-expo")
        (string=? field "title") (option-some-of [:option :string] "中国特许加盟展 (China Franchise Expo), 经中国商务部批准、由中国连锁经营协会主办")
        (string=? field "association") (option-some-of [:option :string] "ccfa")
        (string=? field "isic") (option-some-of [:option :string] "4719")
        (string=? field "country") (option-some-of [:option :string] "CHN")
        (string=? field "kind") (option-some-of [:option :string] "sector-program")
        (string=? field "url") (option-some-of [:option :string] "http://www.ccfa.org.cn/portal/cn/xiangxic.jsp?type=11")
        (string=? field "url-provenance") (option-some-of [:option :string] "official-association-site")
        (string=? field "established-date") (option-some-of [:option :string] "1999")
        (string=? field "last-revised-date") (option-some-of [:option :string] "2025-01-01")
        (string=? field "retrieved-at") (option-some-of [:option :string] "2026-07-27")
        :else (option-none-of [:option :string])))
    (option-none-of [:option :string])))

(defn topic-count [association :string index :i64] :i64
  (if (valid-entry? association index) (if (= index 0) 2 1) 0))
(defn topic [association :string index :i64 topic-index :i64]
  [:option :string]
  (if (valid-entry? association index)
    (if (= index 0)
      (if (= topic-index 0) (option-some-of [:option :string] "governance")
          (if (= topic-index 1) (option-some-of [:option :string] "standards")
              (option-none-of [:option :string])))
      (if (= topic-index 0) (option-some-of [:option :string] "franchising")
          (option-none-of [:option :string])))
    (option-none-of [:option :string])))

(defn by-topic-count [association :string candidate :string] :i64
  (if (association-covered? association)
    (if (string=? candidate "governance") 1
        (if (string=? candidate "standards") 1
            (if (string=? candidate "franchising") 1 0))) 0))
(defn by-topic-id [association :string candidate :string index :i64]
  [:option :string]
  (if (association-covered? association)
    (if (= index 0)
      (if (string=? candidate "governance") (entry-field association 0 "id")
          (if (string=? candidate "standards") (entry-field association 0 "id")
              (if (string=? candidate "franchising") (entry-field association 1 "id")
                  (option-none-of [:option :string]))))
      (option-none-of [:option :string]))
    (option-none-of [:option :string])))
(defn coverage-note [association :string] [:option :string]
  (if (association-covered? association)
    (option-some-of [:option :string]
      "cloud-itonami-assoc-4719-chn-ccfa (ADR-2607141700): 2 ccfa entries seeded from the association's own 简介 page (发布 2025/01/01), read 2026-07-27. Both cite that one page, which is where both facts are stated. CCFA's own scope spans retail, food service and services; 4719 follows the assignment its usa-nrf peer already uses, and is narrower than CCFA itself. Extend the sovereign catalog; never fabricate a rule id/url.")
    (option-none-of [:option :string])))
(defn main [] :i64 0)
